__pycache__/
*.pyc
.DS_Store

# Hugo build outputs
/public/
/resources/_gen/
.hugo_build.lock

# Local, non-redistributable study cache of acquired materials.
# Reproduce locally with scripts/refresh-resources.sh; the committed
# manifest is resources/registry.yml. Contents are NOT redistributed
# (see registry field `redistributable`). Only .gitkeep is tracked so
# the directory exists after clone.
/resources/_downloads/*
!/resources/_downloads/.gitkeep

# Generated catalogue snapshots are committed with their editorial sources.
# CI checks their freshness; unrelated generated data remains ignored.
/static/data/*
!/static/data/resources.de.json
!/static/data/resources.en.json
!/static/data/resources.fr.json
*.tmp
*.log
*~
*.bak
*.orig
/node_modules/
/build/
/go.work
/go.work.sum
/.venv/
